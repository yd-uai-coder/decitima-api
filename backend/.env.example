# backendをホスト上で直接実行する場合（uv run uvicorn ...）に使用する設定。
# docker-compose経由で実行する場合はルート直下の.env.exampleを使う。
# `.env`にコピーして実際の値を設定すること。実際の`.env`はコミットしないこと。

DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/app
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-to-a-random-64-char-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

GOOGLE_API_KEY=
TAVILY_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# チャットメッセージ送信のレート制限（1ユーザーあたりの上限回数）
CHAT_RATE_LIMIT_PER_HOUR=20
CHAT_RATE_LIMIT_PER_DAY=100

ENVIRONMENT=development
DEBUG=true

# 重い solve の実行方式。thread(既定)は、タイムアウト後も計算が止まらない。
# process にすると子プロセスごと kill する(DEPLOYMENT.md「ソルバーの実行方式」)。
# SOLVE_ISOLATION=thread
# SOLVE_MAX_PROCESSES=4
